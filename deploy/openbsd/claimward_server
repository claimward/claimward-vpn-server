#!/bin/ksh
#
# rc.d(8) script for claimward-server on OpenBSD 7.9 / 8.0.
# Install: install -m 0555 claimward_server /etc/rc.d/claimward_server
#          rcctl enable claimward_server && rcctl start claimward_server
#
# The daemon is started as ROOT, and is two processes (privilege separation).
# Both kernel interfaces the server drives refuse anyone else: wg(4) peer
# configuration is behind suser(9) (sys/net/if_wg.c, wg_ioctl_set), and /dev/pf
# is guarded only by its device node (root-only). So the root process does
# those, and nothing else: it holds no secret, serves no network, and unveils
# only /dev/pf. It starts a child as the _claimward user, which holds the
# secrets, the listeners and the policy, and is restricted with unveil(2) and
# pledge(2) before it serves; the child asks the root process for the few
# things the kernel needs (add or remove a peer, the tunnel MTU, the firewall
# of the tenants) and the root process refuses anything outside the address pool.
# The deploy/README.md section "OpenBSD" has the details.
#
# Secrets are files in /etc/claimward/credentials (CREDENTIALS_DIRECTORY),
# owned by _claimward, mode 0400, never the environment.
# /etc/claimward/environment holds only the non-secret settings, as sh
# assignments, and stays root's.

daemon="/usr/local/bin/claimward-server"
daemon_user="root"
# The server logs to stderr: rc.subr pipes it to syslog (daemon.info).
daemon_logger="daemon.info"
rc_bg=YES

. /etc/rc.d/rc.subr

rc_reload=NO

rc_configtest() {
	[ -r /etc/claimward/environment ] || {
		echo "/etc/claimward/environment is missing" >&2
		return 1
	}
	[ -d /etc/claimward/credentials ] || {
		echo "/etc/claimward/credentials is missing" >&2
		return 1
	}
	id _claimward >/dev/null 2>&1 || {
		echo "the _claimward user is missing: useradd -g =uid -c claimward -d /var/empty -s /sbin/nologin -r 1..999 _claimward" >&2
		return 1
	}
	[ "$(stat -f %Su /etc/claimward/credentials)" = "_claimward" ] || {
		echo "/etc/claimward/credentials must be owned by _claimward (chown -R _claimward:_claimward, files 0400)" >&2
		return 1
	}
}

rc_pre() {
	rc_configtest
}

# "Running" means the child LISTENS, not that a process of that name exists.
# rc.subr's default rc_check is a pgrep: while rc_bg=YES it reports a start as
# ok as soon as the process is seen, even when the _claimward child is about to
# refuse a credential it does not own and exit. Waiting for the listener makes
# `rcctl start` fail in that case (the daemon's exit status comes back from
# rc_start) instead of printing (ok) for a daemon that is already gone.
rc_check() {
	pgrep -T "${daemon_rtable}" -q -xf "${pexp}" || return 1
	local _addr _host _port
	_addr=$(set -a; . /etc/claimward/environment 2>/dev/null; echo "${LISTEN_ADDR:-:8443}")
	_host=${_addr%:*}
	_port=${_addr##*:}
	nc -z "${_host:-127.0.0.1}" "${_port}" 2>/dev/null
}

# rc.subr runs the daemon through `su -fl`, which resets the environment, so
# the settings and CREDENTIALS_DIRECTORY are set INSIDE that shell. Secrets are
# never in it: only the directory that holds them.
rc_start() {
	rc_exec "set -a; . /etc/claimward/environment; set +a; \
		CREDENTIALS_DIRECTORY=/etc/claimward/credentials; \
		export CREDENTIALS_DIRECTORY; \
		${daemon} ${daemon_flags}"
}

rc_cmd $1
