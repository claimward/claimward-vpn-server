[Unit]
Description=Claimward VPN control plane
Documentation=https://github.com/claimward/claimward-vpn-server/blob/main/deploy/README.md
# The WireGuard interface (wg0) must already exist: create it with
# wg-quick@wg0 or systemd-networkd. The server only manages its peers.
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/claimward-server
Restart=on-failure
RestartSec=5

# --- Secrets: a credentials directory, never the environment -------------
# systemd decrypts each credential into $CREDENTIALS_DIRECTORY (a private
# tmpfs) and sets the variable. With DynamicUser= the file stays root:root and
# an ACL gives the service's user read access; the server accepts exactly that.
# Create them with `systemd-creds encrypt` (see deploy/README.md).
LoadCredentialEncrypted=wg-private-key:/etc/credstore.encrypted/claimward.wg-private-key
# A github provider (id "hub" in providers.example.json) needs the OAuth app's
# client secret, provider-<id>-secret: only tokens that app minted are admitted.
# Remove this line when no provider is a github one.
LoadCredentialEncrypted=provider-hub-secret:/etc/credstore.encrypted/claimward.provider-hub-secret
# Add the ones your configuration needs; a missing file stops the unit.
#   a go-authn provider <id>    provider-<id>-gateway-secret
#   a tenant with `members`     github-token
#   the admin API/WebUI         admin-token (without it the admin API is off)
#LoadCredentialEncrypted=provider-fed-gateway-secret:/etc/credstore.encrypted/claimward.provider-fed-gateway-secret
#LoadCredentialEncrypted=github-token:/etc/credstore.encrypted/claimward.github-token
#LoadCredentialEncrypted=admin-token:/etc/credstore.encrypted/claimward.admin-token

# --- Configuration (not secret) -----------------------------------------
Environment=WG_ENDPOINT=vpn.example.org:51820
# The identity providers (deploy/providers.example.json), read by the service's
# user: keep the file under /etc/claimward. It holds no secret.
Environment=PROVIDERS_FILE=/etc/claimward/providers.json
# Optional: an SVG logo shown by clients (validated at start, 64 KiB at most).
#Environment=SERVER_LOGO_FILE=/etc/claimward/logo.svg
Environment=WG_INTERFACE=wg0
# /metrics is OFF unless this is set (no default port, so nothing clashes with
# Prometheus on :9090). It names every tenant: keep it on loopback or a
# trusted network.
#Environment=METRICS_ADDR=127.0.0.1:9100
# TENANTS_FILE is read by the service's user: keep it under /etc/claimward
# (world-readable is fine, it holds no secret) and set it here:
#Environment=TENANTS_FILE=/etc/claimward/tenants.json

# --- Hardening ------------------------------------------------------------
DynamicUser=yes
# CAP_NET_ADMIN: wgctrl and nftables, over netlink. Nothing else.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
